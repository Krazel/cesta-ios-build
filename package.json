{
  "name": "cesta",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/server.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "ios:simulator": "node scripts/ios.mjs",
    "ios:device": "node scripts/ios.mjs --device",
    "build:web": "expo export --platform web",
    "build:ios-bundle": "expo export --platform ios --output-dir artifacts/ios-bundle",
    "build:ios-source": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/server.test.mjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/assets.mjs",
    "format": "prettier --write App.tsx src server scripts tests playwright.config.ts app.json eas.json package.json README.md",
    "test:text-import": "node --test tests/textImport.test.mjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
