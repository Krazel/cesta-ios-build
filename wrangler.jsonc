{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cesta",
  "main": "cloud/worker.mjs",
  "account_id": "42b01f1f2e48e76d294dc05978b73923",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "LISTS", "class_name": "SharedList" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SharedList"] }],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "6808982515",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
  "placement": { "mode": "off" },
}
